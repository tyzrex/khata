# Pooled connection for the running app. The hostname includes -pooler.
# Neon console → Connect → "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection for Drizzle migrations. The hostname does NOT include -pooler.
# Neon console → Connect → "Direct connection".
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Session signing secret. Generate with: openssl rand -base64 32
# Required in production: the server refuses requests if it is missing, still this
# placeholder, or shorter than 32 characters. Do not commit a real value.
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Canonical app origin. Local `bun run dev` listens on port 3847.
# Production on Vercel: https://your-domain.example
# Preview deployments: leave this unset so Better Auth uses the request host.
BETTER_AUTH_URL="http://127.0.0.1:3847"

# Optional: extra origins Better Auth should trust, comma-separated (custom domains,
# stable branch aliases). Preview deployments are detected automatically from
# Vercel's own VERCEL_URL / VERCEL_BRANCH_URL environment variables.
TRUSTED_ORIGINS=""

# Google OAuth web client. Redirect URI is {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: email group invites through Resend. Without a key, share the invite link by hand.
# Sending is rate limited: 10 emails per sender per hour, 3 per recipient address per day.
# Use an address on a domain you verified in Resend (SPF + DKIM, plus a DMARC record).
# The shared onboarding@resend.dev sender is for testing and lands in spam or Promotions.
# The display name is replaced per invite with "<Inviter> via Khata"; only the address is used.
RESEND_API_KEY=""
INVITE_FROM_EMAIL="Khata <invites@mail.your-domain.example>"
