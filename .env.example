# Pooled connection for the running app. The hostname includes -pooler.
# Neon console → Connect → "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection for Drizzle migrations. The hostname does NOT include -pooler.
# Neon console → Connect → "Direct connection".
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Optional private gate. Leave empty to keep a local ledger open.
# When set, the browser asks for this passcode, and a daily import can send:
#   Authorization: Bearer <APP_PASSCODE>
APP_PASSCODE=""
